{
  "$schema": "https://biomejs.dev/schemas/2.5.9/schema.json",
  "plugins": [
    "./plugins/no-double-cast.grit",
    "./plugins/no-as-type-assertion.grit",
    "./plugins/no-single-letter-variables.grit",
    "./plugins/no-private-keyword.grit",
    "./plugins/no-underscore-private.grit",
    "./plugins/no-silent-catch.grit",
    "./plugins/no-hardcoded-colors.grit"
  ],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "src/**",
      "packages/*/src/**",
      "packages/zepp/src/**",
      "packages/zepp/page/**",
      "packages/zepp/app-side/**",
      "packages/zepp/setting/**",
      "packages/zepp/app-service/**",
      "packages/zepp/*.ts",
      "packages/mobile/**",
      "scripts/**",
      "cypress/**",
      "*.ts"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error",
        "noTsIgnore": "error",
        "noConsole": "error"
      },
      "performance": {
        "noBarrelFile": "error"
      },
      "style": {
        "noNonNullAssertion": "error",
        "noExcessiveLinesPerFile": {
          "level": "error",
          "options": {
            "maxLines": 1000
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/routeTree.gen.ts"],
      "linter": { "enabled": false },
      "formatter": { "enabled": false },
      "assist": { "enabled": false }
    },
    {
      "includes": ["src/free-exercise-db.json"],
      "linter": { "enabled": false },
      "formatter": { "enabled": false },
      "assist": { "enabled": false }
    },
    {
      "includes": [
        "scripts/**",
        "packages/mobile/scripts/**",
        "packages/mobile/lib/telemetry.ts",
        "packages/mobile/test-setup.ts",
        "packages/server/src/lib/start-worker.ts",
        "src/instrumentation.ts",
        "src/logger.ts",
        "src/providers/whoop-api-contract.test.ts",
        "src/providers/provider-api-contracts.test.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.test.ts", "**/*.test.tsx", "**/*.integration.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noExcessiveLinesPerFile": "off"
          }
        }
      }
    },
    {
      "includes": ["src/db/schema.ts"],
      "linter": {
        "rules": {
          "style": {
            "noExcessiveLinesPerFile": "off"
          }
        }
      }
    }
  ],
  "css": {
    "parser": {
      "cssModules": false,
      "tailwindDirectives": true
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "all"
    }
  }
}
