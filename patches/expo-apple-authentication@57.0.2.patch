new file mode 100644
index 0000000000000000000000000000000000000000..01de395aa97f242e931d4dbdd788c7c9cfb0e8fd
--- /dev/null
+++ b/ios/AppleAuthenticationErrorDiagnostics.swift
@@ -0,0 +1,37 @@
+import Foundation
+
+// Retain only diagnostic codes. NSError/userInfo may contain account data or credentials.
+struct AppleAuthenticationErrorDiagnostics: LocalizedError, Sendable {
+  private let domain: String
+  private let code: Int
+  private let underlyingDomain: String?
+  private let underlyingCode: Int?
+
+  init(_ error: NSError) {
+    domain = Self.safeDomain(error.domain)
+    code = error.code
+    let underlying = error.userInfo[NSUnderlyingErrorKey] as? NSError
+    underlyingDomain = underlying.map { Self.safeDomain($0.domain) }
+    underlyingCode = underlying?.code
+  }
+
+  var errorDescription: String? {
+    let underlying: String
+    if let underlyingDomain, let underlyingCode {
+      underlying = " underlyingDomain=\(underlyingDomain) underlyingCode=\(underlyingCode)"
+    } else {
+      underlying = ""
+    }
+    return "[dofek.apple-auth domain=\(domain) code=\(code)\(underlying)]"
+  }
+
+  private static func safeDomain(_ domain: String) -> String {
+    switch domain {
+    case "com.apple.AuthenticationServices.AuthorizationError", "AKAuthenticationError",
+      NSCocoaErrorDomain, NSPOSIXErrorDomain, NSURLErrorDomain:
+      return domain
+    default:
+      return "other"
+    }
+  }
+}
