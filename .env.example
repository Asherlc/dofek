# Non-secret configuration — committed to the repo.
# Copy to .env.local for local overrides (gitignored).
# Actual secrets (API keys, client secrets, tokens) live in Infisical.

CLICKHOUSE_PASSWORD=health
POSTGRES_PASSWORD=health

# Local Docker Compose publishes DB/ClickHouse/Redis on stable automatically
# assigned host ports. Run `pnpm compose:up` to generate .env.local and start
# the services with those ports.
# POSTGRES_PORT=<generated-port>
# CLICKHOUSE_HTTP_PORT=<generated-port>
# CLICKHOUSE_NATIVE_PORT=<generated-port>
# REDIS_PORT=<generated-port>
# CLICKHOUSE_URL=http://default:health@127.0.0.1:<assigned-port>
# DATABASE_URL=postgres://health:health@127.0.0.1:<assigned-port>/health
# REDIS_URL=redis://127.0.0.1:<assigned-port>

# OAuth callback — set to your public URL
# OAUTH_REDIRECT_URI=https://health.yourdomain.com/callback

# Public app URL used in emails and billing return URLs
# PUBLIC_URL=https://health.yourdomain.com

# Stripe billing (secrets go in Infisical)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_ID=

# App Store subscription verification and Notifications V2. Production values
# belong in Infisical; do not commit the private key or certificate bundle.
# APP_STORE_ISSUER_ID=
# APP_STORE_KEY_ID=
# APP_STORE_PRIVATE_KEY=
# APP_STORE_APP_ID=
# APP_STORE_BUNDLE_ID=
# APP_STORE_SUBSCRIPTION_PRODUCT_ID=
# APP_STORE_ROOT_CERTIFICATES_PEM=

# OAuth client IDs (register with each provider, then add here)
# WAHOO_CLIENT_ID=
# POLAR_CLIENT_ID=
# STRAVA_CLIENT_ID=
# OURA_CLIENT_ID=

# Amazfit/Zepp — optional API host override (see src/providers/README.md)
# ZEPP_API_BASE_URL=

# Sentry error tracking DSN
# SENTRY_DSN=https://<KEY>@o<ORG_ID>.ingest.us.sentry.io/<PROJECT_ID>
# VITE_SENTRY_DSN=https://<KEY>@o<ORG_ID>.ingest.us.sentry.io/<PROJECT_ID>
# EXPO_PUBLIC_SENTRY_DSN=https://<KEY>@o<ORG_ID>.ingest.us.sentry.io/<PROJECT_ID>

# OpenTelemetry endpoint (AXIOM_API_TOKEN goes in Infisical; auth headers
# are constructed from it in with-env.ts / otel-collector-config.yaml)
# OTEL_EXPORTER_OTLP_ENDPOINT=https://api.axiom.co

# Cloudflare R2 endpoint (access keys go in Infisical)
# R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
