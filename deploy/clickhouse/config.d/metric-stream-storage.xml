<clickhouse>
  <storage_configuration>
    <disks>
      <metric_stream_journal>
        <type>local</type>
        <path>/var/lib/clickhouse/metric-stream-journal/</path>
      </metric_stream_journal>
    </disks>
    <policies>
      <metric_stream_journal>
        <volumes>
          <main>
            <disk>metric_stream_journal</disk>
          </main>
        </volumes>
      </metric_stream_journal>
    </policies>
  </storage_configuration>
</clickhouse>
