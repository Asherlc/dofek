+// Expo robots resolve through meActor, while the human-only me field is null.
+// Exercise the normal upload route so its publishing permission depends on
+// the configured actor's identity, not on a username or a nonempty token.
+func TestRequestUploadUrlValidatesExpoActorIdentity(t *testing.T) {
+	actor := func(id, kind string) map[string]interface{} {
+		identity := map[string]interface{}{"id": id, "__typename": kind}
+		if kind == "User" {
+			identity["username"] = "same_name"
+		}
+		return identity
+	}
+	for _, tc := range []struct {
+		name           string
+		server, caller map[string]interface{}
+		graphqlError   string
+		want           int
+	}{
+		{"configured robot", actor("robot-1", "Robot"), actor("robot-1", "Robot"), "", http.StatusOK},
+		{"configured human", actor("user-1", "User"), actor("user-1", "User"), "", http.StatusOK},
+		{"different robot", actor("robot-1", "Robot"), actor("robot-2", "Robot"), "", http.StatusUnauthorized},
+		{"same username different human", actor("user-1", "User"), actor("user-2", "User"), "", http.StatusUnauthorized},
+		{"missing caller", actor("robot-1", "Robot"), nil, "", http.StatusUnauthorized},
+		{"missing server", nil, actor("robot-1", "Robot"), "", http.StatusUnauthorized},
+		{"both missing", nil, nil, "", http.StatusUnauthorized},
+		{"blank caller id", actor("robot-1", "Robot"), actor(" ", "Robot"), "", http.StatusUnauthorized},
+		{"both blank ids", actor("", "User"), actor("", "User"), "", http.StatusUnauthorized},
+		{"caller graphql error with actor", actor("robot-1", "Robot"), actor("robot-1", "Robot"), "caller", http.StatusUnauthorized},
+		{"server graphql error with actor", actor("robot-1", "Robot"), actor("robot-1", "Robot"), "server", http.StatusUnauthorized},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			teardown := setup(t)
+			defer teardown()
+			httpmock.RegisterResponder("POST", "https://api.expo.dev/graphql", func(req *http.Request) (*http.Response, error) {
+				var body struct {
+					Query string `json:"query"`
+				}
+				if err := json.NewDecoder(req.Body).Decode(&body); err != nil {
+					return nil, err
+				}
+				identity := tc.caller
+				lookup := "caller"
+				if req.Header.Get("Authorization") == "Bearer EXPO_ACCESS_TOKEN" {
+					identity = tc.server
+					lookup = "server"
+				}
+				var human map[string]interface{}
+				if identity != nil && identity["__typename"] == "User" {
+					human = identity
+				}
+				data := map[string]interface{}{"me": human}
+				if strings.Contains(body.Query, "meActor") {
+					data = map[string]interface{}{"meActor": identity}
+				}
+				response := map[string]interface{}{"data": data}
+				if tc.graphqlError == lookup {
+					response["errors"] = []map[string]interface{}{{"message": "Authentication failed"}}
+				}
+				return httpmock.NewJsonResponse(http.StatusOK, response)
+			})
+			assert.Equal(t, tc.want, requestUploadUrlWithBearer(t, "Bearer caller_token"))
+		})
+	}
+}
