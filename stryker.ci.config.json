{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker/master/packages/core/schema/stryker-core.schema.json",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "vitest": {
    "configFile": "vitest.config.mutation.ts",
    "related": true
  },
  "ignoreStatic": true,
  "incremental": false,
  "concurrency": 2,
  "mutate": [
    "src/**/*.ts",
    "packages/format/src/**/*.ts",
    "packages/scoring/src/**/*.ts",
    "packages/nutrition/src/**/*.ts",
    "packages/training/src/**/*.ts",
    "packages/recovery/src/**/*.ts",
    "packages/zones/src/**/*.ts",
    "packages/stats/src/**/*.ts",
    "packages/onboarding/src/**/*.ts",
    "packages/providers-meta/src/**/*.ts",
    "packages/auth/src/**/*.ts",
    "packages/mcp-app/src/**/*.ts",
    "packages/mcp-app/src/**/*.tsx",
    "packages/mcp-contracts/src/**/*.ts",
    "packages/server/src/**/*.ts",
    "packages/web/src/lib/**/*.ts",
    "packages/garmin-connect/src/**/*.ts",
    "packages/eight-sleep/src/**/*.ts",
    "packages/whoop-whoop/src/**/*.ts",
    "packages/trainerroad-client/src/**/*.ts",
    "packages/velohero-client/src/**/*.ts",
    "packages/zwift-client/src/**/*.ts",
    "packages/zepp-client/src/**/*.ts",
    "packages/zepp/src/**/*.ts",
    "packages/trainingpeaks-connect/src/**/*.ts",
    "packages/provider-http/src/**/*.ts",
    "packages/peloton-client/src/**/*.ts",
    "packages/xert-client/src/**/*.ts",
    "packages/mobile/app/**/*.{ts,tsx}",
    "packages/mobile/components/**/*.{ts,tsx}",
    "packages/mobile/lib/**/*.{ts,tsx}",
    "!**/*.stories.tsx",
    "!**/*.stories.ts",
    "!**/*.test.ts",
    "!**/*.test.tsx",
    "!**/test-helpers.ts",
    "!packages/server/src/routers/clickhouse-integration-test-helpers.ts",
    "!packages/server/src/routers/clickhouse-integration-test-models.ts",
    "!packages/server/src/routers/clickhouse-integration-test-read-models-*.ts",
    "!**/fixtures/**",
    "!src/db/clickhouse-migrations.ts",
    "!src/db/drizzle-schema.ts",
    "!src/db/schema/**/*.ts",
    "!packages/server/src/types.ts",
    "!packages/zepp/app.ts",
    "!packages/zepp/app-side/**",
    "!packages/zepp/app-service/**",
    "!packages/zepp/page/**",
    "!packages/zepp/setting/**"
  ],
  "ignorePatterns": [
    "packages/training/src/terminology.ts",
    "dist/**",
    "packages/mobile/modules/whoop-ble/.build/**",
    ".adal/**",
    ".aider-desk/**",
    ".antigravitycli/**",
    ".augment/**",
    ".codegraph/**",
    ".codex/**",
    ".claude/**",
    ".context/**",
    ".gemini/**",
    ".kilocode/**",
    ".qwen/**",
    ".windsurf/**",
    ".agents/**",
    "**/skills/stripe-projects"
  ],
  "mutator": {
    "excludedMutations": ["StringLiteral"]
  },
  "testRunnerNodeArgs": ["--import", "tsx"],
  "dryRunTimeoutMinutes": 15,
  "timeoutMS": 15000,
  "thresholds": {
    "high": 100,
    "low": 90,
    "break": 75
  },
  "reporters": ["clear-text", "progress-append-only", "dots", "json"],
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  }
}
