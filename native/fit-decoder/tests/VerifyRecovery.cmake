foreach(mode IN ITEMS recovery-truncated recovery-crc recovery-malformed recovery-footer-overlap recovery-weight recovery-empty recovery-invalid-header recovery-header-signature recovery-header-protocol recovery-header-zero-data recovery-chained-signature recovery-chained-size recovery-intact-chain recovery-nonactivity recovery-missing-type recovery-invalid-timestamp recovery-activity-weight)
  set(fixture "${CMAKE_CURRENT_BINARY_DIR}/${mode}.fit")
  execute_process(COMMAND "${FIXTURE_WRITER}" "${fixture}" "${mode}" RESULT_VARIABLE fixture_result)
  if(NOT fixture_result EQUAL 0)
    message(FATAL_ERROR "Unable to write ${mode} fixture")
  endif()
  file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/recovery-ack.txt" "continue\ncontinue\ncontinue\ncontinue\ncontinue\n")
  execute_process(
    COMMAND "${DECODER}" "${fixture}"
    INPUT_FILE "${CMAKE_CURRENT_BINARY_DIR}/recovery-ack.txt"
    OUTPUT_VARIABLE output
    ERROR_VARIABLE error
    RESULT_VARIABLE result
  )
  if(mode STREQUAL "recovery-intact-chain")
    if(NOT result EQUAL 0)
      message(FATAL_ERROR "An intact chain must retain normal SDK decoding: ${error}")
    endif()
    string(REPLACE "\n" ";" lines "${output}")
    set(metadata_seen FALSE)
    set(record_count 0)
    set(end_seen FALSE)
    foreach(line IN LISTS lines)
      if(line STREQUAL "")
        continue()
      endif()
      string(JSON type GET "${line}" type)
      if(type STREQUAL "metadata")
        set(metadata_seen TRUE)
        string(JSON warning_type TYPE "${line}" recoveryError)
        if(NOT warning_type STREQUAL "NULL")
          message(FATAL_ERROR "An intact chain must have a null recovery warning")
        endif()
      elseif(type STREQUAL "records")
        string(JSON count LENGTH "${line}" messages)
        math(EXPR record_count "${record_count} + ${count}")
      elseif(type STREQUAL "end")
        set(end_seen TRUE)
        string(JSON message_count GET "${line}" messageCount)
        if(NOT message_count EQUAL 2)
          message(FATAL_ERROR "Intact chain reported unexpected end count ${message_count}")
        endif()
      endif()
    endforeach()
    if(NOT metadata_seen OR NOT record_count EQUAL 2 OR NOT end_seen)
      message(FATAL_ERROR "Intact chain did not emit both records and end")
    endif()
  elseif(mode STREQUAL "recovery-weight" OR mode STREQUAL "recovery-empty" OR mode MATCHES "recovery-invalid-header|recovery-header-|recovery-chained-" OR mode STREQUAL "recovery-nonactivity" OR mode STREQUAL "recovery-missing-type" OR mode STREQUAL "recovery-invalid-timestamp" OR mode STREQUAL "recovery-activity-weight")
    if(result EQUAL 0 OR NOT error MATCHES "FIT decode failed:")
      message(FATAL_ERROR "${mode} should fail with a decoder error (status ${result}): ${error}; output: ${output}")
    endif()
    if(NOT output STREQUAL "")
      message(FATAL_ERROR "${mode} must fail before emitting protocol data")
    endif()
  else()
    if(NOT result EQUAL 0)
      message(FATAL_ERROR "${mode} should recover: ${error}")
    endif()
    string(REPLACE "\n" ";" lines "${output}")
    set(metadata_seen FALSE)
    set(record_count 0)
    set(end_seen FALSE)
    set(recovery_error "")
    foreach(line IN LISTS lines)
      if(line STREQUAL "")
        continue()
      endif()
      string(JSON type GET "${line}" type)
      if(type STREQUAL "metadata")
        set(metadata_seen TRUE)
        string(JSON warning_type TYPE "${line}" recoveryError)
        string(JSON warning GET "${line}" recoveryError)
        if(NOT warning_type STREQUAL "STRING" OR warning STREQUAL "")
          message(FATAL_ERROR "${mode} omitted its recovery warning")
        endif()
      elseif(type STREQUAL "records")
        string(JSON count LENGTH "${line}" messages)
        math(EXPR record_count "${record_count} + ${count}")
      elseif(type STREQUAL "end")
        set(end_seen TRUE)
        string(JSON message_count GET "${line}" messageCount)
        if(NOT message_count EQUAL 1)
          message(FATAL_ERROR "${mode} reported unexpected end count ${message_count}")
        endif()
      endif()
    endforeach()
    if(NOT metadata_seen OR NOT record_count EQUAL 1 OR NOT end_seen)
      message(FATAL_ERROR "${mode} did not emit exactly one complete record and end")
    endif()
  endif()
endforeach()

set(ack_fixture "${CMAKE_CURRENT_BINARY_DIR}/recovery-bad-ack.fit")
execute_process(COMMAND "${FIXTURE_WRITER}" "${ack_fixture}" "recovery-truncated" RESULT_VARIABLE fixture_result)
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/recovery-no-ack.txt" "continue\n")
execute_process(
  COMMAND "${DECODER}" "${ack_fixture}"
  INPUT_FILE "${CMAKE_CURRENT_BINARY_DIR}/recovery-no-ack.txt"
  OUTPUT_VARIABLE ack_output
  ERROR_VARIABLE ack_error
  RESULT_VARIABLE ack_result
)
if(ack_result EQUAL 0 OR NOT ack_error MATCHES "continue acknowledgement")
  message(FATAL_ERROR "A missing final-batch acknowledgement must remain fatal: ${ack_error}")
endif()
if(NOT ack_output MATCHES "\\\"type\\\":\\\"records\\\"")
  message(FATAL_ERROR "Expected the recovered final batch before the missing-ack failure")
endif()
if(ack_output MATCHES "\\\"type\\\":\\\"end\\\"")
  message(FATAL_ERROR "A missing final-batch acknowledgement must prevent end")
endif()
