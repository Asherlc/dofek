set(fixture "${CMAKE_CURRENT_BINARY_DIR}/workout-structure.fit")
execute_process(COMMAND "${FIXTURE_WRITER}" "${fixture}" workout-structure COMMAND_ERROR_IS_FATAL ANY)
set(acknowledgements "${CMAKE_CURRENT_BINARY_DIR}/workout-structure-acknowledgements.txt")
file(WRITE "${acknowledgements}" "continue\ncontinue\ncontinue\ncontinue\n")
execute_process(
  COMMAND "${DECODER}" "${fixture}"
  INPUT_FILE "${acknowledgements}"
  OUTPUT_VARIABLE output
  COMMAND_ERROR_IS_FATAL ANY
)
string(STRIP "${output}" output)
string(REPLACE "\n" ";" lines "${output}")
list(LENGTH lines line_count)
if(NOT line_count EQUAL 5)
  message(FATAL_ERROR "Expected metadata, workout structure, records, workout structure and end")
endif()
list(GET lines 1 before_record)
list(GET lines 2 record)
list(GET lines 3 after_record)
list(GET lines 4 end)

function(assert_field line expected)
  string(JSON actual GET "${line}" ${ARGN})
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "Expected ${ARGN} to equal ${expected}, got ${actual}")
  endif()
endfunction()

assert_field("${before_record}" "workout-structure" type)
assert_field("${before_record}" "workout" messages 0 messageType)
assert_field("${before_record}" "LSCT" messages 0 raw wkt_name)
assert_field("${before_record}" "workout_step" messages 1 messageType)
assert_field("${before_record}" "360000" messages 1 raw duration_value)
assert_field("${before_record}" "60" messages 1 raw custom_target_value_low)
assert_field("${before_record}" "60" messages 1 raw custom_target_value_high)
assert_field("${before_record}" "zones_target" messages 2 messageType)
assert_field("${before_record}" "190" messages 2 raw max_heart_rate)
assert_field("${record}" "records" type)
assert_field("${after_record}" "workout-structure" type)
assert_field("${after_record}" "lap" messages 0 messageType)
assert_field("${after_record}" "0" messages 0 raw wkt_step_index)
assert_field("${after_record}" "360" messages 0 raw total_elapsed_time)
assert_field("${after_record}" "360" messages 0 raw total_timer_time)
assert_field("${end}" "5" messageCount)
