foreach(mode IN ITEMS with-file-id no-file-id byte-bound)
  set(fixture "${CMAKE_CURRENT_BINARY_DIR}/hardware-${mode}.fit")
  execute_process(COMMAND "${FIXTURE_WRITER}" "${fixture}" "${mode}" RESULT_VARIABLE fixture_result)
  if(NOT fixture_result EQUAL 0)
    message(FATAL_ERROR "Unable to write hardware fixture")
  endif()
  set(acknowledgement_file "${CMAKE_CURRENT_BINARY_DIR}/hardware-acknowledgements.txt")
  file(WRITE "${acknowledgement_file}" "continue\ncontinue\ncontinue\ncontinue\ncontinue\ncontinue\ncontinue\ncontinue\ncontinue\ncontinue\n")
  execute_process(
    COMMAND "${DECODER}" "${fixture}"
    INPUT_FILE "${acknowledgement_file}"
    OUTPUT_VARIABLE protocol_output
    ERROR_VARIABLE decoder_error
    RESULT_VARIABLE decoder_result
  )
  if(NOT decoder_result EQUAL 0)
    message(FATAL_ERROR "FIT decoder failed: ${decoder_error}")
  endif()
  string(REPLACE "\n" ";" protocol_lines "${protocol_output}")
  set(device_count 0)
  set(device_batches 0)
  set(record_count 0)
  set(metadata_seen FALSE)
  set(end_seen FALSE)
  foreach(line IN LISTS protocol_lines)
    if(line STREQUAL "")
      continue()
    endif()
    string(LENGTH "${line}" line_bytes)
    if(line_bytes GREATER_EQUAL 524288)
      message(FATAL_ERROR "Hardware protocol exceeded the 512 KiB limit")
    endif()
    string(JSON type GET "${line}" type)
    if(end_seen)
      message(FATAL_ERROR "Hardware protocol continued after end")
    endif()
    if(NOT metadata_seen AND NOT type STREQUAL "metadata")
      message(FATAL_ERROR "Hardware messages arrived before metadata")
    endif()
    if(type STREQUAL "metadata")
      if(metadata_seen)
        message(FATAL_ERROR "Hardware protocol repeated metadata")
      endif()
      set(metadata_seen TRUE)
      string(JSON file_id_type TYPE "${line}" fileId)
      if(mode STREQUAL "no-file-id")
        if(NOT file_id_type STREQUAL "NULL")
          message(FATAL_ERROR "Missing file_id must remain null")
        endif()
      else()
        string(JSON manufacturer GET "${line}" fileId manufacturer)
        string(JSON product GET "${line}" fileId product)
        string(JSON serial GET "${line}" fileId serial_number)
        if(NOT manufacturer EQUAL 1 OR NOT product EQUAL 3121 OR NOT serial EQUAL 123456)
          message(FATAL_ERROR "Raw file_id fields were not retained")
        endif()
      endif()
    elseif(type STREQUAL "devices")
      math(EXPR device_batches "${device_batches} + 1")
      string(JSON batch_size LENGTH "${line}" messages)
      if(batch_size GREATER 250 OR batch_size LESS 1)
        message(FATAL_ERROR "Device batch violates the 250-message bound")
      endif()
      if(device_count EQUAL 0)
        string(JSON product_name GET "${line}" messages 0 product_name)
        if(NOT product_name STREQUAL "Observed sensor")
          message(FATAL_ERROR "First sensor identity was not retained")
        endif()
      endif()
      math(EXPR last_index "${batch_size} - 1")
      foreach(index RANGE 0 ${last_index})
        if(device_count GREATER 0)
          string(JSON battery GET "${line}" messages ${index} battery_voltage)
          math(EXPR battery_step "${device_count} % 4")
          set(expected_batteries 3 2.75 2.5 2.25)
          list(GET expected_batteries ${battery_step} expected_battery)
          if(NOT battery STREQUAL expected_battery)
            message(FATAL_ERROR "Repeated observations changed order")
          endif()
        endif()
        math(EXPR device_count "${device_count} + 1")
      endforeach()
    elseif(type STREQUAL "records")
      if(NOT device_count EQUAL 251)
        message(FATAL_ERROR "Interleaved record and device observations changed order")
      endif()
      string(JSON batch_size LENGTH "${line}" messages)
      math(EXPR record_count "${record_count} + ${batch_size}")
    elseif(type STREQUAL "end")
      set(end_seen TRUE)
      string(JSON count GET "${line}" messageCount)
      if(NOT count EQUAL 502)
        message(FATAL_ERROR "End count must include all 501 device messages and the record")
      endif()
    else()
      message(FATAL_ERROR "Unexpected hardware protocol type: ${type}")
    endif()
  endforeach()
  if(NOT device_count EQUAL 501 OR NOT record_count EQUAL 1 OR NOT end_seen)
    message(FATAL_ERROR "Hardware observations were lost: ${device_count} devices, ${record_count} records")
  endif()
  if(mode STREQUAL "byte-bound" AND device_batches LESS 4)
    message(FATAL_ERROR "Large device messages did not exercise the byte bound")
  endif()
endforeach()
