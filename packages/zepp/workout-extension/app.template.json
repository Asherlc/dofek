{
  "configVersion": "v3",
  "app": {
    "appId": 0,
    "appName": "Dofek Workout",
    "appType": "app",
    "extType": "workout",
    "version": {
      "code": 1,
      "name": "1.0.0"
    },
    "icon": "icon.png",
    "vender": "Dofek",
    "description": "Captures rich live workout data and syncs it to Dofek."
  },
  "permissions": [
    "data:user.hd.workout",
    "data:user.hd.heart_rate"
  ],
  "runtime": {
    "apiVersion": {
      "compatible": "3.6",
      "target": "4.0",
      "minVersion": "3.6"
    }
  },
  "targets": {
    "common": {
      "module": {
        "data-widget": {
          "widgets": [
            {
              "path": "data-widget/index",
              "name": "Dofek Workout",
              "icon": "icon.png",
              "window": {
                "isPinned": 1
              },
              "runtime": {
                "ability": [
                  {
                    "type": 1,
                    "subType": []
                  }
                ]
              }
            }
          ]
        },
        "app-side": {
          "path": "app-side/index"
        },
        "setting": {
          "path": "setting/index"
        }
      },
      "platforms": [
        {
          "st": "r",
          "dw": 480
        },
        {
          "st": "s",
          "dw": 390
        }
      ],
      "designWidth": 480
    }
  },
  "defaultLanguage": "en-US"
}
