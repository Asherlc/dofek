{
  "name": "@dofek/zepp",
  "version": "1.0.0",
  "description": "Raw IMU logger for Zepp OS API_LEVEL 3.0+ devices",
  "type": "module",
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "dev": "pnpm tsx build.ts && zeus dev",
    "build": "pnpm tsx build.ts && zeus build",
    "preview": "zeus preview",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=26"
  },
  "license": "MIT",
  "devDependencies": {
    "@zeppos/device-types": "^3.0.0",
    "esbuild": "0.28.1",
    "typescript": "6.0.3",
    "vitest": "3.2.6"
  },
  "dependencies": {
    "@zeppos/zml": "^0.0.43"
  }
}
