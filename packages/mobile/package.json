    "expo-linking": "58.0.11",
    "expo-network": "58.0.3",
    "expo-notifications": "58.1.1",
    "expo-router": "58.0.15",
    "expo-secure-store": "58.0.2",
    "expo-sharing": "58.0.15",
    "expo-splash-screen": "58.0.6",
    "expo-updates": "58.0.15",
    "expo-web-browser": "58.0.6",
    "posthog-react-native": "4.61.2",
    "react": "19.3.0",
    "react-native": "0.88.0-rc.3",
    "react-native-body-highlighter": "3.2.0",
    "react-native-gesture-handler": "3.2.1",
    "react-native-maps": "1.29.0",
    "react-native-reanimated": "4.7.0",
    "react-native-safe-area-context": "5.9.1",
