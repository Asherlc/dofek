{
  "name": "dofek-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "expo": {
    "install": {
      "exclude": [
        "@sentry/react-native",
        "typescript"
      ]
    }
  },
  "scripts": {
    "start": "expo start",
    "storybook": "EXPO_PUBLIC_STORYBOOK_ENABLED=true sb-rn-get-stories && EXPO_PUBLIC_STORYBOOK_ENABLED=true expo start --clear",
    "storybook:ios": "EXPO_PUBLIC_STORYBOOK_ENABLED=true expo run:ios",
    "storybook:web": "storybook dev -p 6007 --config-dir .storybook",
    "build-storybook": "storybook build --config-dir .storybook",
    "app-store:screenshots": "pnpm tsx ./scripts/capture-app-store-screenshots.ts",
    "app-store:assets": "pnpm build-storybook && pnpm app-store:screenshots",
    "ios": "expo run:ios",
    "ios:device": "expo run:ios --device",
    "prebuild": "expo prebuild --platform ios --clean",
    "lint": "biome check . && pnpm --dir ../.. lint:mobile-telemetry && pnpm --dir ../.. check:mobile-app-routes",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-crypto/sha256-browser": "5.2.0",
    "@bacons/apple-targets": "4.0.7",
    "@dofek/auth": "workspace:*",
    "@dofek/format": "workspace:*",
    "@dofek/imu": "workspace:*",
    "@dofek/nutrition": "workspace:*",
    "@dofek/onboarding": "workspace:*",
    "@dofek/providers": "workspace:*",
    "@dofek/scoring": "workspace:*",
    "@dofek/stats": "workspace:*",
    "@dofek/training": "workspace:*",
    "@dofek/zones": "workspace:*",
    "@expo/metro-runtime": "57.0.14",
    "@expo/vector-icons": "15.1.1",
    "@formatjs/intl-getcanonicallocales": "3.2.11",
    "@formatjs/intl-locale": "5.3.9",
    "@formatjs/intl-numberformat": "9.3.14",
    "@formatjs/intl-pluralrules": "6.3.12",
    "@opentelemetry/api-logs": "0.221.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.221.0",
    "@opentelemetry/resources": "2.10.0",
    "@opentelemetry/sdk-logs": "0.221.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@sentry/cli": "3.6.1",
    "@sentry/react-native": "8.20.0",
    "@tanstack/query-async-storage-persister": "5.101.4",
    "@tanstack/react-query": "5.101.2",
    "@tanstack/react-query-persist-client": "5.101.2",
    "@trpc/client": "11.18.0",
    "@trpc/react-query": "11.18.0",
    "dofek-server": "workspace:*",
    "expo": "57.0.18",
    "expo-apple-authentication": "57.0.1",
    "expo-build-properties": "57.0.15",
    "expo-clipboard": "57.0.1",
    "expo-crypto": "57.0.2",
    "expo-dev-client": "57.0.16",
    "expo-document-picker": "57.0.1",
    "expo-file-system": "57.0.6",
    "expo-haptics": "57.0.2",
    "expo-linking": "57.0.8",
    "expo-modules-core": "57.0.14",
    "expo-notifications": "57.0.15",
    "expo-router": "57.0.17",
    "expo-secure-store": "57.0.2",
    "expo-sharing": "57.0.16",
    "expo-splash-screen": "57.0.8",
    "expo-updates": "57.0.19",
    "expo-web-browser": "57.0.2",
    "posthog-react-native": "4.61.2",
    "react": "19.2.8",
    "react-native": "0.86.3",
    "react-native-body-highlighter": "3.2.0",
    "react-native-gesture-handler": "2.32.0",
    "react-native-maps": "1.27.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.27.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@storybook/addon-ondevice-actions": "10.5.3",
    "@storybook/addon-ondevice-controls": "10.5.3",
    "@storybook/react-native": "10.5.3",
    "@storybook/react-native-web-vite": "10.5.4",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.18",
    "playwright": "1.62.1",
    "react-dom": "19.2.8",
    "react-native-web": "0.21.2",
    "storybook": "10.5.4",
    "typescript": "6.0.3",
    "vite": "8.0.16"
  }
}
