  "devDependencies": {
    "@storybook/addon-ondevice-actions": "10.6.0",
    "@storybook/addon-ondevice-controls": "10.6.0",
    "@storybook/react-native": "10.6.0",
    "@storybook/react-native-web-vite": "10.6.0",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.3.0",
    "playwright": "1.62.1",
    "react-dom": "19.3.0",
    "react-native-web": "0.21.3",
    "storybook": "10.6.0",
    "typescript": "6.0.3",
    "vite": "8.0.16"
  }
}
