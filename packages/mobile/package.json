{
  "name": "dofek-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "expo": {
    "install": {
      "exclude": [
        "@sentry/react-native",
        "typescript"
      ]
    }
  },
  "scripts": {
    "start": "expo start",
    "storybook": "EXPO_PUBLIC_STORYBOOK_ENABLED=true sb-rn-get-stories && EXPO_PUBLIC_STORYBOOK_ENABLED=true expo start --clear",
    "storybook:ios": "EXPO_PUBLIC_STORYBOOK_ENABLED=true expo run:ios",
    "storybook:web": "storybook dev -p 6007 --config-dir .storybook",
    "build-storybook": "storybook build --config-dir .storybook",
    "app-store:screenshots": "node ./scripts/capture-app-store-screenshots.mjs",
    "app-store:assets": "pnpm build-storybook && pnpm app-store:screenshots",
    "ios": "expo run:ios",
    "ios:device": "expo run:ios --device",
    "prebuild": "expo prebuild --platform ios --clean",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bacons/apple-targets": "4.0.7",
    "@dofek/auth": "workspace:*",
    "@dofek/format": "workspace:*",
    "@dofek/imu": "workspace:*",
    "@dofek/nutrition": "workspace:*",
    "@dofek/onboarding": "workspace:*",
    "@dofek/providers": "workspace:*",
    "@dofek/scoring": "workspace:*",
    "@dofek/training": "workspace:*",
    "@dofek/zones": "workspace:*",
    "@expo/metro-runtime": "56.0.15",
    "@expo/vector-icons": "15.1.1",
    "@formatjs/intl-getcanonicallocales": "3.2.9",
    "@formatjs/intl-locale": "5.3.8",
    "@formatjs/intl-numberformat": "9.3.10",
    "@formatjs/intl-pluralrules": "6.3.9",
    "@opentelemetry/api-logs": "0.218.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.218.0",
    "@opentelemetry/resources": "2.7.1",
    "@opentelemetry/sdk-logs": "0.218.0",
    "@opentelemetry/semantic-conventions": "1.41.1",
    "@sentry/cli": "3.4.2",
    "@sentry/react-native": "8.11.1",
    "@tanstack/react-query": "5.90.21",
    "@trpc/client": "11.12.0",
    "@trpc/react-query": "11.12.0",
    "dofek-server": "workspace:*",
    "expo": "56.0.12",
    "expo-apple-authentication": "56.0.4",
    "expo-build-properties": "56.0.19",
    "expo-camera": "56.0.8",
    "expo-file-system": "56.0.8",
    "expo-haptics": "56.0.3",
    "expo-linking": "56.0.14",
    "expo-location": "56.0.18",
    "expo-modules-core": "56.0.17",
    "expo-router": "56.2.11",
    "expo-secure-store": "56.0.4",
    "expo-sharing": "56.0.18",
    "expo-splash-screen": "56.0.10",
    "expo-task-manager": "56.0.19",
    "expo-updates": "56.0.19",
    "expo-web-browser": "56.0.5",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-body-highlighter": "3.1.4",
    "react-native-maps": "1.27.2",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@storybook/addon-ondevice-actions": "10.4.4",
    "@storybook/addon-ondevice-controls": "10.4.4",
    "@storybook/react-native": "10.4.4",
    "@storybook/react-native-web-vite": "10.4.0",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.14",
    "playwright": "1.55.0",
    "react-dom": "19.2.3",
    "react-native-web": "0.21.2",
    "storybook": "10.4.0",
    "typescript": "6.0.3",
    "vite": "8.0.13"
  }
}
