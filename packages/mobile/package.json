{
  "name": "dofek-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "expo": {
    "install": {
      "exclude": [
        "@sentry/react-native",
        "typescript"
      ]
    }
  },
  "scripts": {
    "start": "expo start",
    "storybook:native": "EXPO_PUBLIC_STORYBOOK_ENABLED=true sb-rn-get-stories && EXPO_PUBLIC_STORYBOOK_ENABLED=true expo start --clear",
    "storybook:ios": "EXPO_PUBLIC_STORYBOOK_ENABLED=true expo run:ios",
    "storybook:web": "storybook dev -p 6007 --config-dir .storybook",
    "build-storybook": "storybook build --config-dir .storybook",
    "app-store:screenshots": "pnpm tsx ./scripts/capture-app-store-screenshots.ts",
    "app-store:assets": "pnpm build-storybook && pnpm app-store:screenshots",
    "ios": "expo run:ios",
    "ios:device": "expo run:ios --device",
    "prebuild": "expo prebuild --platform ios --clean",
    "lint": "biome check . && pnpm --dir ../.. lint:mobile-telemetry && pnpm --dir ../.. check:mobile-app-routes",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-crypto/sha256-browser": "5.2.0",
    "@bacons/apple-targets": "5.0.0",
    "@dofek/auth": "workspace:*",
    "@dofek/format": "workspace:*",
    "@dofek/imu": "workspace:*",
    "@dofek/mcp-contracts": "workspace:*",
    "@dofek/nutrition": "workspace:*",
    "@dofek/onboarding": "workspace:*",
    "@dofek/providers": "workspace:*",
    "@dofek/scoring": "workspace:*",
    "@dofek/stats": "workspace:*",
    "@dofek/training": "workspace:*",
    "@dofek/zones": "workspace:*",
    "@expo/metro-runtime": "58.0.12",
    "@expo/vector-icons": "15.1.1",
    "@formatjs/intl-getcanonicallocales": "3.2.12",
    "@formatjs/intl-locale": "5.3.10",
    "@formatjs/intl-numberformat": "9.4.0",
    "@formatjs/intl-pluralrules": "6.3.13",
    "@opentelemetry/api-logs": "0.221.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.221.0",
    "@opentelemetry/resources": "2.10.0",
    "@opentelemetry/sdk-logs": "0.221.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-community/slider": "5.2.1",
    "@sentry/cli": "3.7.0",
    "@sentry/react-native": "8.29.0",
    "@tanstack/query-async-storage-persister": "5.101.4",
    "@tanstack/react-query": "5.101.2",
    "@tanstack/react-query-persist-client": "5.101.2",
    "@trpc/client": "11.18.0",
    "@trpc/react-query": "11.18.0",
    "dofek-server": "workspace:*",
    "expo": "58.0.5",
    "expo-apple-authentication": "58.0.2",
    "expo-build-properties": "58.0.10",
    "expo-clipboard": "58.0.3",
    "expo-constants": "58.0.10",
