{
  "name": "@dofek/oura-ble",
  "version": "0.1.0",
  "description": "Bluetooth pairing and event sync client for Oura Ring",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Asherlc/dofek.git",
    "directory": "packages/oura-ble"
  },
  "homepage": "https://github.com/Asherlc/dofek/tree/main/packages/oura-ble#readme",
  "bugs": "https://github.com/Asherlc/dofek/issues",
  "keywords": [
    "oura",
    "oura-ring",
    "bluetooth",
    "ble",
    "expo",
    "react-native"
  ],
  "engines": {
    "node": ">=22.14.0"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "expo-module.config.json",
    "ios/OuraBle.podspec",
    "ios/*.swift",
    "ios/generated/*.swift",
    "ios/generated/OuraBleCore.xcframework",
    "ios/generated/THIRD-PARTY-LICENSES.txt",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./expo": "./src/expo.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./expo": {
        "types": "./dist/expo.d.ts",
        "import": "./dist/expo.js"
      }
    }
  },
  "scripts": {
    "build": "tsc",
    "build:ios": "tsx scripts/build-ios.ts",
    "prepack": "pnpm run build && test -f ios/generated/OuraBleCore.xcframework/Info.plist && test -f ios/generated/oura_ble_core.swift && test -f ios/generated/THIRD-PARTY-LICENSES.txt",
    "test": "vitest run src",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "expo": "58.0.26"
  },
  "peerDependencies": {
    "expo": ">=58.0.0"
  },
  "peerDependenciesMeta": {
    "expo": {
      "optional": true
    }
  }
}
