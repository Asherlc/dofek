{
  "name": "@dofek/mountain-project",
  "version": "0.1.0",
  "description": "Unofficial TypeScript client for Mountain Project public tick exports",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Asherlc/dofek.git",
    "directory": "packages/mountain-project-client"
  },
  "homepage": "https://github.com/Asherlc/dofek/tree/main/packages/mountain-project-client#readme",
  "bugs": "https://github.com/Asherlc/dofek/issues",
  "keywords": ["mountain-project", "climbing", "api-client", "unofficial", "typescript"],
  "engines": { "node": ">=22.14.0" },
  "sideEffects": false,
  "files": ["dist", "README.md", "LICENSE"],
  "exports": {
    ".": "./src/client.ts",
    "./*": "./src/*.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": { "types": "./dist/client.d.ts", "import": "./dist/client.js" },
      "./*": { "types": "./dist/*.d.ts", "import": "./dist/*.js" }
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "build": "tsc",
    "prepack": "pnpm run build",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": { "@dofek/training": "workspace:*" },
  "devDependencies": { "typescript": "6.0.3", "vitest": "3.2.6" }
}
