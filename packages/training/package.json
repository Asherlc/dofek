{
  "name": "@dofek/training",
  "version": "0.1.40",
  "description": "Training-science calculations for power, load, performance, and workout planning",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Asherlc/dofek.git",
    "directory": "packages/training"
  },
  "homepage": "https://github.com/Asherlc/dofek/tree/main/packages/training#readme",
  "bugs": "https://github.com/Asherlc/dofek/issues",
  "keywords": [
    "training",
    "cycling",
    "running",
    "power",
    "tss",
    "trimp",
    "fitness"
  ],
  "engines": {
    "node": ">=22.14.0"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./power-duration-reference": "./src/power-duration-reference.ts",
    "./*": "./src/*.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      "./power-duration-reference": {
        "types": "./dist/power-duration-reference.d.ts",
        "import": "./dist/power-duration-reference.js"
      },
      "./*": {
        "types": "./dist/*.d.ts",
        "import": "./dist/*.js"
      }
    }
  },
  "dependencies": {
    "@dofek/scoring": "workspace:*",
    "@dofek/zones": "workspace:*",
    "@openbeta/sandbag": "0.0.55",
    "zod": "4.4.3"
  },
  "scripts": {
    "build": "tsc",
    "prepack": "pnpm run build",
    "test": "vitest run src",
    "typecheck": "tsc --noEmit"
  }
}
