{
  "name": "@dofek/provider-http",
  "version": "0.1.8",
  "description": "Rate-limit-aware Fetch utilities and typed provider HTTP errors",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Asherlc/dofek.git",
    "directory": "packages/provider-http"
  },
  "homepage": "https://github.com/Asherlc/dofek/tree/main/packages/provider-http#readme",
  "bugs": "https://github.com/Asherlc/dofek/issues",
  "keywords": [
    "fetch",
    "http",
    "rate-limit",
    "retry-after",
    "typescript"
  ],
  "engines": {
    "node": ">=22.14.0"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./src/rate-limit.ts",
    "./rate-limit": "./src/rate-limit.ts",
    "./adaptive-rate-limit": "./src/adaptive-rate-limit.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/rate-limit.d.ts",
        "import": "./dist/rate-limit.js"
      },
      "./rate-limit": {
        "types": "./dist/rate-limit.d.ts",
        "import": "./dist/rate-limit.js"
      },
      "./adaptive-rate-limit": {
        "types": "./dist/adaptive-rate-limit.d.ts",
        "import": "./dist/adaptive-rate-limit.js"
      }
    }
  },
  "scripts": {
    "build": "tsc",
    "prepack": "pnpm run build",
    "test": "vitest run src",
    "typecheck": "tsc --noEmit"
  }
}
