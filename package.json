  "scripts": {
    "dev": "tsx scripts/with-env.ts -- tsx src/index.ts",
    "sync": "tsx scripts/with-env.ts -- tsx src/index.ts sync",
    "auth": "tsx scripts/with-env.ts -- tsx src/index.ts auth",
    "compose": "tsx scripts/compose-command.ts",
    "compose:env": "tsx scripts/compose-env.ts",
    "compose:up": "tsx scripts/compose-env.ts --up",
    "dev:environment": "tsx scripts/dev-environment.ts",
    "migrate": "tsx scripts/with-env.ts -- drizzle-kit migrate && tsx scripts/generate-schema-diagram.ts",
    "setup-db": "tsx scripts/with-env.ts -- tsx src/db/run-migrate.ts",
    "analytics:build": "pnpm tsx scripts/with-env.ts -- pnpm tsx scripts/run-local-analytics-build.ts",
    "seed": "tsx scripts/seed-dev-db.ts",
    "review:seed-clickhouse": "tsx scripts/with-env.ts -- tsx scripts/seed-review-clickhouse.ts",
    "generate": "drizzle-kit generate && tsx scripts/generate-schema-diagram.ts",
    "schema:diagram": "tsx scripts/generate-schema-diagram.ts",
    "schema:view": "tsx scripts/generate-schema-diagram.ts --open",
    "release:npm:build": "lerna run build --stream",
    "release:npm:test": "vitest run --project unit packages/provider-http packages/scoring packages/zones packages/training packages/eight-sleep packages/garmin-connect packages/peloton-client packages/trainerroad-client packages/trainingpeaks-connect packages/velohero-client packages/whoop-whoop packages/xert-client packages/zepp-client packages/zwift-client",
    "release:npm:publish": "pnpm --recursive publish --access public --no-git-checks",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm lint:sandbox && pnpm lint:analytics-sql",
    "lint:sandbox": "pnpm lint:exact-versions && biome check . --max-diagnostics=500 && pnpm lint:suppressions && pnpm lint:workflow-downloads && pnpm lint:analytics-policy && pnpm lint:mobile-telemetry && pnpm lint:web-stories && pnpm lint:review-scenarios && pnpm check:mobile-app-routes",
    "lint:fix": "biome check --write .",
    "lint:exact-versions": "tsx scripts/exact-versions.ts",
    "lint:openapi": "redocly lint docs/whoop-api.openapi.yaml docs/kaya-api.openapi.yaml packages/server/openapi/external-v1.yaml --extends minimal",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:suppressions": "tsx scripts/no-suppressions.ts",
    "lint:workflow-downloads": "tsx scripts/workflow-download-policy.ts .github/workflows .github/actions",
    "lint:analytics-sql": "sh -c 'set -a; [ ! -f .env.local ] || . ./.env.local; set +a; cd analytics && UV_PROJECT_ENVIRONMENT=../.venv-analytics uv run --project . sqlfluff lint --ignore parsing models'",
    "lint:analytics-policy": "sh -c 'files=$(find analytics src/db/clickhouse-sql -path \"analytics/target\" -prune -o -path \"analytics/logs\" -prune -o -path \"analytics/dbt_packages\" -prune -o -name \"*.sql\" -type f -print 2>/dev/null); if [ -z \"$files\" ]; then echo \"No analytics SQL files to lint\"; else tsx scripts/migration-policy.ts $files; fi'",
    "lint:mobile-telemetry": "tsx scripts/mobile-catch-telemetry-policy.ts packages/mobile",
    "lint:web-stories": "pnpm tsx scripts/web-story-coverage-policy.ts packages/web/src/components",
    "lint:review-scenarios": "pnpm tsx scripts/review-scenario-coverage-policy.ts packages/web/src packages/mobile",
    "lint:migrations": "sh -c 'files=$(git diff --diff-filter=AM --name-only origin/main...HEAD -- \"drizzle/*.sql\" \":(exclude)drizzle/_history/*.sql\"); if [ -z \"$files\" ]; then echo \"No changed migrations to lint\"; else tsx scripts/migration-policy.ts $files; fi'",
    "sherif": "sherif",
    "format": "biome format --write .",
    "test": "vitest --project unit --project mobile",
    "clickhouse-cdc": "tsx scripts/with-env.ts -- tsx scripts/run-clickhouse-cdc.ts",
    "check:clickhouse-cdc": "tsx scripts/with-env.ts -- tsx scripts/check-clickhouse-cdc.ts",
    "check:database-backup-freshness": "tsx scripts/check-database-backup-freshness.ts",
    "catch-up:metric-stream": "tsx scripts/with-env.ts -- tsx scripts/catch-up-clickhouse-metric-stream.ts",
    "backfill:body-measurements": "tsx scripts/with-env.ts -- tsx scripts/backfill-body-measurement-sample.ts",
    "backfill:hang-ten-workouts": "tsx scripts/with-env.ts -- tsx scripts/backfill-hang-ten-workouts.ts",
    "backfill:activity-overview-availability": "tsx scripts/with-env.ts -- tsx scripts/backfill-activity-overview-availability.ts",
    "backfill:climbing-attempt-count": "tsx scripts/with-env.ts -- tsx scripts/backfill-climbing-attempt-count.ts",
    "backfill:sleep-quality": "tsx scripts/with-env.ts -- tsx scripts/backfill-sleep-quality.ts",
    "backfill:record-local-time": "tsx scripts/with-env.ts -- tsx scripts/backfill-record-local-time-context.ts",
    "backfill:provider-connections": "tsx scripts/with-env.ts -- tsx scripts/backfill-provider-connections.ts",
    "backfill:exercise-provenance": "tsx scripts/backfill-exercise-provenance.ts",
    "test:all": "tsx scripts/run-tests.ts all",
    "test:changed": "vitest run --changed origin/main --project unit --project mobile",
    "test:changed:all": "tsx scripts/run-tests.ts changed",
    "test:integration": "tsx scripts/run-tests.ts integration",
    "test:unit": "vitest run --project unit",
    "test:watch": "vitest --watch --project unit --project mobile",
    "test:coverage": "vitest run --project unit --project mobile --coverage",
    "test:coverage:all": "tsx scripts/run-tests.ts all --coverage",
    "test:mutation": "stryker run",
    "knip": "knip --config knip.json",
    "server": "tsx scripts/with-env.ts -- tsx src/server.ts",
    "build": "tsc",
    "build:fit-decoder": "cd native/fit-decoder && cmake --preset release && cmake --build --preset release",
    "start": "node dist/index.js",
    "test:mobile": "vitest run --project mobile",
    "test:mobile:watch": "vitest --watch --project mobile",
    "e2e:web:up": "pnpm compose -- --project-suffix e2e -f docker-compose.e2e.yml up -d --build --wait",
    "e2e:web:up:reuse": "tsx scripts/e2e-web-reuse.ts --up-only",
    "e2e:web:down": "pnpm compose -- --project-suffix e2e -f docker-compose.e2e.yml down -v",
    "e2e:web:run": "pnpm exec cypress run",
    "e2e:web:open": "pnpm exec cypress open",
    "e2e:web": "tsx scripts/e2e-web.ts",
    "e2e:web:reuse": "tsx scripts/e2e-web-reuse.ts",
    "mobile": "pnpm --filter dofek-mobile start",
    "mobile:device": "pnpm --filter dofek-mobile ios:device",
    "storybook": "pnpm --filter dofek-web storybook",
    "storybook:build": "pnpm --filter dofek-web build-storybook",
    "storybook:web": "pnpm --filter dofek-web storybook",
    "storybook:web:build": "pnpm --filter dofek-web build-storybook",
    "storybook:mobile": "pnpm --filter dofek-mobile storybook",
    "storybook:mobile:ios": "pnpm --filter dofek-mobile storybook:ios",
    "storybook:mobile:web": "pnpm --filter dofek-mobile storybook:web",
    "storybook:mobile:build": "pnpm --filter dofek-mobile build-storybook",
    "app-store:mobile:screenshots": "pnpm --filter dofek-mobile app-store:assets",
    "size": "size-limit",
    "depcruise": "depcruise --config .dependency-cruiser.cjs src/ packages/",
    "spellcheck": "cspell --no-progress",
    "check:mobile-update": "tsx scripts/check-ota-manifest.ts",
    "check:mobile-app-routes": "pnpm tsx scripts/check-mobile-app-route-files.ts"
  },
