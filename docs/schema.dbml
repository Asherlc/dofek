  dataset_keys text[] [not null]
  expected_event_count integer [not null]
  published_at "timestamp with time zone" [not null, default: `now()`]

  indexes {

    (operation_id, batch_id) [name: 'processing_metric_stream_batch_key', unique]


  }
}

table fitness.processing_operation {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  user_id uuid
  provider_id text
  kind text [not null]
  external_correlation_key text
  dataset_keys text[] [not null]
  created_at "timestamp with time zone" [not null, default: `now()`]

  indexes {

    (user_id, kind, external_correlation_key) [name: 'processing_operation_correlation_key', unique]
    (user_id, created_at, id) [name: 'processing_operation_user_created_idx']


  }
}

table fitness.processing_operation_output {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  operation_id uuid [not null]
  dataset_key text [not null]
  output_path text [not null]
  created_at "timestamp with time zone" [not null, default: `now()`]

  indexes {

    (operation_id, dataset_key, output_path) [name: 'processing_operation_output_key', unique]

  }
}

table fitness.processing_queue_outbox {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  operation_id uuid [not null]
  queue_name text [not null]
  job_id text [not null]
  status text [not null, default: 'pending']
  created_at "timestamp with time zone" [not null, default: `now()`]
  dispatched_at "timestamp with time zone"

  indexes {

    (queue_name, job_id) [name: 'processing_queue_outbox_job_key', unique]
    (status, created_at) [name: 'processing_queue_outbox_dispatch_idx']

  }
}

table fitness.processing_stage_event {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  sequence bigint [not null]
  operation_id uuid [not null]
  stage text [not null]
  status text [not null]
  dataset_key text
  output_path text
  model_name text
  occurred_at "timestamp with time zone" [not null, default: `now()`]
  progress_percentage integer
  source_watermark text
  serving_watermark text
  message text
  error_code text
  error_message text
  metadata_schema_version integer [not null, default: 1]
  metadata jsonb
  idempotency_key text [not null]

  indexes {

    (operation_id, stage, dataset_key, output_path, model_name, status, idempotency_key) [name: 'processing_stage_event_idempotency_key', unique]
    (operation_id, sequence) [name: 'processing_stage_event_operation_sequence_idx']
    (dataset_key, sequence) [name: 'processing_stage_event_dataset_sequence_idx']





  }
}

