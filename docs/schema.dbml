enum activity_modality {
  road
  mountain
  gravel
  indoor
  virtual
  electric
  cyclocross
  track
  bmx
  trail
  open_water
  functional
  mixed
  mixed_metabolic
  cross_country
  downhill
  paddleboard
  ice
  cardio
  social
  hand_cycle
  wheelchair
  cooldown
}

enum canonical_activity_type {
  cycling
  running
  swimming
  walking
  hiking
  strength
  yoga
  pilates
  tai_chi
  mind_and_body
  meditation
  breathwork
  stretching
  barre
  elliptical
  rowing
  cardio
  hiit
  stair_climbing
  step_training
  jump_rope
  fitness_gaming
  cross_training
  bootcamp
  circuit_training
  core
  boxing
  kickboxing
  martial_arts
  group_exercise
  skiing
  snowboarding
  snow_sports
  snowshoeing
  skating
  surfing
  kayaking
  sailing
  paddling
  water_fitness
  water_polo
  water_sports
  diving
  snorkeling
  tennis
  table_tennis
  squash
  racquetball
  badminton
  pickleball
  padel
  basketball
  soccer
  american_football
  australian_football
  gaelic_football
  rugby
  hockey
  lacrosse
  baseball
  softball
  volleyball
  cricket
  handball
  golf
  disc_golf
  climbing
  dance
  triathlon
  multisport
  disc_sports
  equestrian
  fencing
  fishing
  hunting
  gymnastics
  archery
  bowling
  curling
  wrestling
  track_and_field
  play
  navigation
  geocaching
  skydiving
  paragliding
  preparation_and_recovery
  transition
  other
}

enum climbing_attempt_outcome {
  sent
  failed
}

enum climbing_climb_type {
  boulder
  route
}

enum climbing_failure_reason {
  fell
  pumped
  skin
  technique
  fear
}

enum climbing_grade_system {
  v_scale
  yds
}

enum climbing_hold_type {
  crimp
  sloper
  pinch
  pocket
  jug
}

enum finger_loading_exercise {
  max_hang
  repeater
  min_edge
  one_arm
  campus
  no_hang
}

enum finger_loading_grip_position {
  half_crimp
  full_crimp
  open_hand
  three_finger_drag
  two_finger_pocket
}

enum finger_loading_laterality {
  both
  left
  right
}

enum food_category {
  beans_and_legumes
  beverages
  breads_and_cereals
  cheese_milk_and_dairy
  eggs
  fast_food
  fish_and_seafood
  fruit
  meat
  nuts_and_seeds
  pasta_rice_and_noodles
  salads
  sauces_spices_and_spreads
  snacks
  soups
  sweets_candy_and_desserts
  vegetables
  supplement
  other
}

enum lab_result_status {
  final
  preliminary
  corrected
  cancelled
}

enum meal {
  breakfast
  lunch
  dinner
  snack
  other
}

enum nutrition_entry_grain {
  itemized
  daily_aggregate
}

enum set_type {
  working
  warmup
  dropset
  failure
}

enum sleep_stage_name {
  deep
  light
  rem
  awake
}

enum supplement_dose_status {
  planned
  taken
  skipped
  unknown
}

table fitness.device_priority {
  provider_id text [not null]
  source_name_pattern text [not null]
  priority integer
  sleep_priority integer
  body_priority integer
  recovery_priority integer
  daily_activity_priority integer

  indexes {
    (provider_id, source_name_pattern) [pk]
  }
}

table fitness.exercise {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  name text [not null]
  muscle_group text
  muscle_groups text[]
  equipment text
  exercise_type text
  movement text
  created_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
    (name, equipment) [name: 'exercise_name_equipment_idx', unique]
  }
}

table fitness.exercise_alias {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  exercise_id uuid [not null]
  provider_id text [not null]
  provider_exercise_id text
  provider_exercise_name text [not null]

  indexes {
    (id, exercise_id) [name: 'exercise_alias_id_exercise_idx', unique]
    (provider_id, provider_exercise_name) [name: 'exercise_alias_provider_name_idx', unique]
  }
}

table fitness.exercise_alias_source {
  alias_id uuid [not null]
  source_id uuid [not null]
  exercise_id uuid [not null]
  created_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
    (alias_id, source_id) [pk]


    exercise_id [name: 'exercise_alias_source_exercise_idx']
    source_id [name: 'exercise_alias_source_source_idx']
  }
}

table fitness.exercise_source {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  exercise_id uuid [not null]
  source_kind text [not null]
  user_id uuid
  provider_id text
  created_at "timestamp with time zone" [not null, default: `now()`]

  indexes {

    (id, exercise_id) [name: 'exercise_source_id_exercise_idx', unique]
    exercise_id [name: 'exercise_source_system_idx', unique]
    (exercise_id, user_id, provider_id) [name: 'exercise_source_user_provider_idx', unique]
    user_id [name: 'exercise_source_user_idx']
  }
}

table fitness.oauth_token {
  user_id uuid [not null]
  provider_id text [not null]
  access_token text [not null]
  refresh_token text
  provider_account_id text
  expires_at "timestamp with time zone" [not null]
  scopes text
  created_at "timestamp with time zone" [not null, default: `now()`]
  updated_at "timestamp with time zone" [not null, default: `now()`]

  indexes {

    (user_id, provider_id) [pk]

    provider_id [name: 'oauth_token_provider_idx']
    user_id [name: 'oauth_token_user_idx']
  }
}

table fitness.provider {
  id text [pk, not null]
  name text [not null]
  api_base_url text
  user_id uuid
  created_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
    (user_id, name) [name: 'provider_user_name_idx', unique]
  }
}

table fitness.provider_connection {
  user_id uuid [not null]
  provider_id text [not null]
  created_at "timestamp with time zone" [not null, default: `now()`]
  updated_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
    (user_id, provider_id) [pk]
    provider_id [name: 'provider_connection_provider_idx']
  }
}

table fitness.provider_priority {
  provider_id text [pk, not null]
  priority integer [not null, default: 100]
  sleep_priority integer
  body_priority integer
  recovery_priority integer
  daily_activity_priority integer
}

table fitness.provider_priority_audit {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  changed_at "timestamp with time zone" [not null, default: `now()`]
  changed_by text [not null]
  priority_table text [not null]
  provider_id text [not null]
  source_name_pattern text
  channel text
  old_value jsonb
  new_value jsonb
  reason text

  indexes {
    changed_at [name: 'provider_priority_audit_changed_at_idx']
    provider_id [name: 'provider_priority_audit_provider_idx']
  }
}

table fitness.sensor_device_priority {
  provider_id text [not null]
  source_name_pattern text [not null]
  channel text [not null]
  priority bigint [not null, default: 1000]

  indexes {
    (provider_id, source_name_pattern, channel) [pk]
  }
}

table fitness.sensor_provider_priority {
  provider_id text [not null]
  channel text [not null]
  priority bigint [not null, default: 1000]

  indexes {
    (provider_id, channel) [pk]
  }
}

table fitness.user_profile {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  name text [not null]
  email text [unique]
  birth_date date
  max_hr smallint
  resting_hr smallint
  ftp smallint
  is_admin boolean [not null, default: false]
  created_at "timestamp with time zone" [not null, default: `now()`]
  updated_at "timestamp with time zone" [not null, default: `now()`]
}

table fitness.webhook_subscription {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  user_id uuid
  provider_id text
  provider_name text [not null]
  subscription_external_id text
  verify_token text [not null]
  signing_secret text
  status text [not null, default: 'active']
  expires_at "timestamp with time zone"
  metadata jsonb
  created_at "timestamp with time zone" [not null, default: `now()`]
  updated_at "timestamp with time zone" [not null, default: `now()`]

  indexes {

    provider_name [name: 'webhook_subscription_app_provider_name_idx', unique]
    (user_id, provider_id) [name: 'webhook_subscription_user_provider_idx', unique]
    provider_name [name: 'webhook_subscription_provider_name_idx']
  }
}

table fitness.activity {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  provider_id text [not null]
  user_id uuid [not null]
  external_id text [not null]
  canonical_type canonical_activity_type [not null]
  provider_type text [not null]
  modality activity_modality
  started_at "timestamp with time zone" [not null]
  ended_at "timestamp with time zone"
  name text
  notes text
  perceived_exertion real
  source_name text
  timezone text
  start_utc_offset_minutes bigint
  end_utc_offset_minutes bigint
  local_time_source text [not null, default: 'unknown']
  strava_id text
  raw jsonb
  provider_absent_at "timestamp with time zone"
  deleted_at "timestamp with time zone"
  created_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
    (user_id, provider_id, external_id) [name: 'activity_provider_external_idx', unique]
    (user_id, provider_id) [name: 'activity_user_provider_idx']

  }
}

table fitness.activity_interval {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  activity_id uuid [not null]
  interval_index integer [not null]
  label text
  interval_type text
  started_at "timestamp with time zone" [not null]
  ended_at "timestamp with time zone"
  created_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
    (activity_id, interval_index) [name: 'activity_interval_activity_idx']
  }
}

table fitness.climbing_attempt {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  climbing_entry_id uuid [not null]
  attempt_index integer [not null]
  outcome climbing_attempt_outcome [not null]
  failure_reason climbing_failure_reason
  notes text
  created_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
    climbing_entry_id [name: 'climbing_attempt_entry_idx']
    (climbing_entry_id, attempt_index) [name: 'climbing_attempt_entry_index_idx', unique]



  }
}

table fitness.climbing_entry {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  activity_id uuid [not null]
  external_id text
  climb_type climbing_climb_type [not null]
  grade_system climbing_grade_system [not null]
  grade text [not null]
  sent boolean
  attempt_count integer [default: 1]
  wall_angle_degrees real
  hold_type climbing_hold_type
  route_name text
  location_name text
  source_name text
  raw jsonb
  created_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
    activity_id [name: 'climbing_entry_activity_idx']
    (climb_type, grade_system, grade) [name: 'climbing_entry_grade_lookup_idx']
    (activity_id, external_id) [name: 'climbing_entry_activity_external_id_idx', unique]
  }
}

table fitness.daily_metric_type {
  id text [pk, not null]
  display_name text [not null]
  unit text
  category text [not null]
  priority_category text [not null, default: 'activity']
  sort_order integer [not null, default: 0]
  is_integer boolean [not null, default: false]
}

table fitness.daily_metric_value {
  daily_metrics_id uuid [not null]
  metric_type_id text [not null]
  value real [not null]

  indexes {
    (daily_metrics_id, metric_type_id) [pk]
    daily_metrics_id [name: 'daily_metric_value_entry_idx']
    metric_type_id [name: 'daily_metric_value_type_idx']
  }
}

table fitness.daily_metrics {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  date date [not null]
  provider_id text [not null]
  user_id uuid [not null]
  hrv real
  spo2_avg real
  respiratory_rate_avg real
  steps integer
  active_energy_kcal real
  basal_energy_kcal real
  distance_km real
  flights_climbed integer
  exercise_minutes integer
  walking_speed real
  walking_step_length real
  walking_double_support_pct real
  walking_asymmetry_pct real
  walking_steadiness real
  stand_hours integer
  skin_temp_c real
  stress_high_minutes integer
  recovery_high_minutes integer
  resilience_level text
  push_count integer
  wheelchair_distance_km real
  uv_exposure real
  source_name text
  created_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
    (user_id, provider_id) [name: 'daily_metrics_user_provider_idx']
  }
}

table fitness.finger_loading_entry {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  activity_id uuid [not null]
  exercise finger_loading_exercise [not null]
  edge_size_mm real
  grip_position finger_loading_grip_position
  external_load_kg real [not null]
  bodyweight_kg real [not null]
  laterality finger_loading_laterality [not null]
  set_count integer [not null]
  hold_duration_seconds real [not null]
  rest_interval_seconds integer [not null]
  rpe real
  notes text
  created_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
    activity_id [name: 'finger_loading_entry_activity_idx']







  }
}

table fitness.sleep_session {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  provider_id text [not null]
  user_id uuid [not null]
  external_id text
  started_at "timestamp with time zone" [not null]
  ended_at "timestamp with time zone"
  duration_minutes integer
  deep_minutes integer
  rem_minutes integer
  light_minutes integer
  awake_minutes integer
  efficiency_pct real
  staging_available boolean [not null, default: false]
  sleep_type text
  is_nap boolean [not null, default: false]
  sleep_need_baseline_minutes integer
  sleep_need_from_debt_minutes integer
  sleep_need_from_strain_minutes integer
  sleep_need_from_nap_minutes integer
  source_name text
  timezone text
  start_utc_offset_minutes bigint
  end_utc_offset_minutes bigint
  local_time_source text [not null, default: 'unknown']
  created_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
    (user_id, provider_id, external_id) [name: 'sleep_session_provider_external_idx', unique]
    (user_id, provider_id) [name: 'sleep_session_user_provider_idx']

  }
}

table fitness.sleep_stage {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  session_id uuid [not null]
  stage sleep_stage_name [not null]
  started_at "timestamp with time zone" [not null]
  ended_at "timestamp with time zone" [not null]
  source_name text
  created_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
    (session_id, started_at) [name: 'sleep_stage_session_idx']
  }
}

table fitness.sport_settings {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  user_id uuid [not null]
  sport text [not null]
  ftp smallint
  threshold_hr smallint
  threshold_pace_per_km real
  power_zone_pcts jsonb
  hr_zone_pcts jsonb
  pace_zone_pcts jsonb
  effective_from date [not null, default: `now()`]
  notes text
  created_at "timestamp with time zone" [not null, default: `now()`]
  updated_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
    (user_id, sport, effective_from) [name: 'sport_settings_user_sport_date_idx', unique]
    user_id [name: 'sport_settings_user_idx']
  }
}

table fitness.strength_set {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  activity_id uuid [not null]
  exercise_id uuid [not null]
  exercise_index integer [not null]
  set_index integer [not null]
  set_type set_type [default: 'working']
  weight_kg real
  reps integer
  distance_meters real
  duration_seconds integer
  strap_location text
  strap_location_laterality text
  rpe real
  notes text
  created_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
    activity_id [name: 'strength_set_activity_idx']
  }
}

table fitness.food_entry {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  provider_id text [not null]
  user_id uuid [not null]
  external_id text
  date date [not null]
  nutrition_grain nutrition_entry_grain
  meal meal
  food_name text
  food_description text
  category food_category
  provider_food_id text
  provider_serving_id text
  number_of_units real
  logged_at "timestamp with time zone"
  source_name text
  started_at "timestamp with time zone"
  ended_at "timestamp with time zone"
  barcode text
  serving_unit text
  serving_weight_grams real
  raw jsonb
  confirmed boolean [not null, default: true]
  created_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
    (user_id, provider_id, external_id) [name: 'food_entry_provider_external_idx', unique]
    date [name: 'food_entry_date_idx']
    (date, meal) [name: 'food_entry_date_meal_idx']
    (user_id, provider_id) [name: 'food_entry_user_provider_idx']
  }
}

table fitness.food_entry_nutrient {
  food_entry_id uuid [not null]
  nutrient_id text [not null]
  amount real [not null]

  indexes {
    (food_entry_id, nutrient_id) [pk]
    food_entry_id [name: 'food_entry_nutrient_entry_idx']
  }
}

table fitness.nutrient {
  id text [pk, not null]
  display_name text [not null]
  unit text [not null]
  category text [not null]
  rda real
  sort_order integer [not null, default: 0]
  open_food_facts_key text
  conversion_factor real [not null, default: 1]
}

table fitness.supplement {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  user_id uuid [not null]
  sort_order bigint [not null, default: 0]
  created_at "timestamp with time zone" [not null, default: `now()`]
  updated_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
    (id, user_id) [name: 'supplement_id_user_key', unique]
    user_id [name: 'supplement_user_idx']
  }
}

table fitness.supplement_definition {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  supplement_id uuid [not null]
  supersedes_definition_id uuid
  name text [not null]
  amount real
  unit text
  form text
  description text
  meal meal
  effective_from date [not null, default: `CURRENT_DATE`]
  effective_to date
  created_at "timestamp with time zone" [not null, default: `now()`]

  indexes {

    (id, supplement_id) [name: 'supplement_definition_identity_key', unique]
    supersedes_definition_id [name: 'supplement_definition_supersedes_key', unique]
    supplement_id [name: 'supplement_definition_active_idx', unique]
    (supplement_id, effective_from, effective_to) [name: 'supplement_definition_effective_idx']


  }
}

table fitness.supplement_definition_nutrient {
  definition_id uuid [not null]
  nutrient_id text [not null]
  amount real [not null]

  indexes {
    (definition_id, nutrient_id) [pk]
    definition_id [name: 'supplement_definition_nutrient_definition_idx']
  }
}

table fitness.supplement_dose_event {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  user_id uuid [not null]
  supplement_id uuid [not null]
  definition_id uuid [not null]
  provider_id text [not null]
  external_id text
  scheduled_date date [not null]
  status supplement_dose_status [not null]
  supersedes_event_id uuid
  recorded_at "timestamp with time zone" [not null]
  source_name text
  raw jsonb
  created_at "timestamp with time zone" [not null, default: `now()`]

  indexes {



    (id, user_id, supplement_id, definition_id, scheduled_date) [name: 'supplement_dose_event_slot_identity_key', unique]
    supersedes_event_id [name: 'supplement_dose_event_successor_key', unique]
    (user_id, supplement_id, scheduled_date) [name: 'supplement_dose_event_root_key', unique]
    (user_id, provider_id, external_id) [name: 'supplement_dose_event_provider_external_idx', unique]
    (user_id, scheduled_date) [name: 'supplement_dose_event_user_date_idx']
    supplement_id [name: 'supplement_dose_event_supplement_idx']

  }
}

table fitness.allergy_intolerance {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  provider_id text [not null]
  user_id uuid [not null]
  external_id text
  name text [not null]
  type text
  clinical_status text
  verification_status text
  rxnorm_code text
  onset_date date
  reactions jsonb
  source_name text
  raw jsonb
  created_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
    (user_id, provider_id, external_id) [name: 'allergy_intolerance_provider_external_idx', unique]
    (user_id, provider_id) [name: 'allergy_intolerance_user_provider_idx']
  }
}

table fitness.condition {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  provider_id text [not null]
  user_id uuid [not null]
  external_id text
  name text [not null]
  clinical_status text
  verification_status text
  icd10_code text
  snomed_code text
  onset_date date
  abatement_date date
  recorded_date date
  source_name text
  raw jsonb
  created_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
    (user_id, provider_id, external_id) [name: 'condition_provider_external_idx', unique]
    (user_id, provider_id) [name: 'condition_user_provider_idx']
  }
}

table fitness.health_event {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  provider_id text [not null]
  user_id uuid [not null]
  external_id text
  type text [not null]
  value real
  value_text text
  unit text
  source_name text
  start_date "timestamp with time zone" [not null]
  end_date "timestamp with time zone"
  created_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
    (user_id, provider_id, external_id) [name: 'health_event_provider_external_idx', unique]
    (type, start_date) [name: 'health_event_type_time_idx']
    (user_id, provider_id) [name: 'health_event_user_provider_idx']
  }
}

table fitness.lab_panel {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  provider_id text [not null]
  user_id uuid [not null]
  external_id text
  name text [not null]
  loinc_code text
  status lab_result_status
  source_name text
  recorded_at "timestamp with time zone" [not null]
  issued_at "timestamp with time zone"
  raw jsonb
  created_at "timestamp with time zone" [not null, default: `now()`]

