{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "sentry": {
        "type": "remote",
        "url": "https://mcp.sentry.dev/mcp",
        "oauth": {}
      },
      "axiom": {
        "type": "remote",
        "url": "https://mcp.axiom.co/mcp"
      },
      "context7": {
        "type": "local",
        "command": ["npx", "-y", "@upstash/context7-mcp"]
      },
      "chrome-devtools": {
        "type": "local",
        "command": ["npx", "-y", "chrome-devtools-mcp@latest"]
      },
      "openaiDeveloperDocs": {
        "type": "remote",
        "url": "https://developers.openai.com/mcp"
      },
      "github": {
        "type": "local",
        "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
        "environment": {
          "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_PERSONAL_ACCESS_TOKEN}"
        }
      }
    }
  },
  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "ssh *", "effect": "allow" },
    { "action": "shell", "resource": "sshpass *", "effect": "allow" },
    { "action": "shell", "resource": "ssh-keygen *", "effect": "allow" },
    { "action": "shell", "resource": "ssh-add *", "effect": "allow" },
    { "action": "shell", "resource": "scp *", "effect": "allow" },
    { "action": "shell", "resource": "brew install *", "effect": "allow" },
    { "action": "shell", "resource": "ping *", "effect": "allow" },
    { "action": "shell", "resource": "curl *", "effect": "allow" },
    { "action": "shell", "resource": "python3 *", "effect": "allow" },
    { "action": "shell", "resource": "op item list *", "effect": "allow" },
    { "action": "shell", "resource": "op item get *", "effect": "allow" },
    { "action": "shell", "resource": "dig *", "effect": "allow" },
    { "action": "shell", "resource": "nslookup *", "effect": "allow" },
    { "action": "shell", "resource": "cat *", "effect": "allow" },
    { "action": "shell", "resource": "ls *", "effect": "allow" },
    { "action": "shell", "resource": "find *", "effect": "allow" },
    { "action": "shell", "resource": "git-crypt status *", "effect": "allow" },
    { "action": "shell", "resource": "scutil *", "effect": "allow" },
    { "action": "shell", "resource": "dscacheutil *", "effect": "allow" },
    { "action": "shell", "resource": "sudo killall *", "effect": "allow" },
    { "action": "shell", "resource": "docker compose *", "effect": "allow" },
    { "action": "shell", "resource": "docker ps *", "effect": "allow" },
    { "action": "shell", "resource": "git add *", "effect": "allow" },
    { "action": "shell", "resource": "git commit *", "effect": "allow" },
    { "action": "shell", "resource": "git push *", "effect": "allow" },
    { "action": "shell", "resource": "git fetch *", "effect": "allow" },
    { "action": "shell", "resource": "git merge *", "effect": "allow" },
    { "action": "shell", "resource": "git switch *", "effect": "allow" },
    { "action": "shell", "resource": "git checkout *", "effect": "allow" },
    { "action": "shell", "resource": "git stash *", "effect": "allow" },
    { "action": "shell", "resource": "git reset *", "effect": "allow" },
    { "action": "shell", "resource": "git ls-remote *", "effect": "allow" },
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git log *", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "gh *", "effect": "allow" },
    { "action": "shell", "resource": "pnpm *", "effect": "allow" },
    { "action": "shell", "resource": "npx eas *", "effect": "allow" },
    { "action": "shell", "resource": "terraform *", "effect": "allow" },
    { "action": "websearch", "resource": "*", "effect": "allow" }
  ]
}
