{
  "workspaces": {
    ".": {
      "entry": [
        "src/index.ts",
        "src/server.ts",
        "src/db/setup-clickhouse-cdc.ts",
        "src/jobs/worker.ts",
        "src/opentelemetry-hook.mjs",
        "scripts/collect-clickhouse-ci-diagnostics.ts",
        "scripts/run-analytics-build.ts",
        "scripts/warm-query-cache.ts",
        "scripts/ota-storage.ts",
        "scripts/rehearse-ota-storage.ts",
        "scripts/check-ota-image-visibility.ts",
        "vitest.config.mutation.ts"
      ],
      "project": ["src/**/*.ts", "src/**/*.mjs", "*.config.{ts,js}", "scripts/clickhouse-ci-diagnostics.ts", "scripts/ota-migration-layout.ts", "scripts/verify-ota-update.ts"],
      "ignoreDependencies": ["supports-color"],
      "ignoreBinaries": [
        "cmake", "dbt", "expo", "infisical", "open", "openssl", "uv",
        "GPL-2.0-or-later", "GPL-3.0-only", "GPL-3.0-or-later",
        "AGPL-1.0-only", "AGPL-3.0-only", "AGPL-3.0-or-later"
      ],
      "vitest": {
        "config": ["vitest.config.ts"],
        "entry": ["src/**/*.test.ts", "src/**/*.integration.test.ts"]
      }
    },
    "packages/server": {
      "entry": ["src/index.ts"],
      "vitest": {
        "config": ["../../vitest.config.ts"],
        "entry": ["src/**/*.test.ts", "src/**/*.integration.test.ts"]
      }
    },
    "packages/web": {
      "entry": ["test-setup.ts"],
      "vitest": {
        "config": ["../../vitest.config.ts"],
        "entry": ["src/**/*.test.{ts,tsx}"]
      }
    },
    "packages/mobile": {
      "entry": [
        "app/**/*.{ts,tsx}",
        "fingerprint.config.js",
        "modules/*/index.ts",
        "plugins/*.js",
        "scripts/capture-app-store-screenshots.ts",
        "scripts/test-ios-bridge.ts",
        "types/api.ts",
        "theme.ts",
        "theme.ios.ts"
      ],
      "project": [
        "**/*.{ts,tsx,js}",
        "!**/ios/**",
        "!**/targets/**",
        "!modules/*/Tests/**",
        "!modules/*/.build/**",
        "!.rnstorybook/**"
      ],
      "ignore": [".rnstorybook/**", ".storybook/mocks/**"],
      "ignoreBinaries": ["pod", "xcrun"],
      "ignoreDependencies": [
        "@sentry/cli",
        "expo-system-ui"
      ]
    },
    "packages/whoop-whoop": {
      "vitest": {
        "config": ["../../vitest.config.ts"],
        "entry": ["src/**/*.test.ts"]
      }
    },
    "packages/eight-sleep": {},
    "packages/zwift-client": {
      "vitest": {
        "config": ["../../vitest.config.ts"],
        "entry": ["src/**/*.test.ts"]
      }
    },
    "packages/zepp-client": {
      "vitest": {
        "config": ["../../vitest.config.ts"],
        "entry": ["src/**/*.test.ts"]
      }
    },
    "packages/trainerroad-client": {},
    "packages/mountain-project-client": {
      "vitest": {
        "config": ["../../vitest.config.ts"],
        "entry": ["src/**/*.test.ts"]
      }
    },
    "packages/trainingpeaks-connect": {
      "vitest": {
        "config": ["../../vitest.config.ts"],
        "entry": ["src/**/*.test.ts"]
      }
    },
    "packages/zepp": {
      "entry": [
        "build.ts",
        "app.ts",
        "page/index.ts",
        "app-side/index.ts",
        "setting/index.ts",
        "app-service/health_service.ts",
        "tools/decode-imu.ts",
        "tools/zeus.ts",
        "workout-extension/app.ts",
        "workout-extension/build.ts",
        "workout-extension/data-widget/index.ts",
        "workout-extension/setting/index.ts",
        "workout-extension/zeus.ts"
      ],
      "ignore": ["src/__mocks__/**"],
      "ignoreDependencies": ["@zeppos/device-types", "@zos/app-access", "@zos/ui"],
      "vitest": {
        "config": ["vitest.config.ts"],
        "entry": ["src/**/*.test.ts"]
      }
    }
  },
  "ignoreExportsUsedInFile": true
}
